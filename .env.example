# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and is never committed.
#
# Phase 1 (data, signals, backtest) needs NONE of these — market data is free/keyless.
# Phase 2 (the LLM decision engine) needs the Anthropic key:

ANTHROPIC_API_KEY=

# Optional overrides:
# FUND_MODEL=claude-sonnet-5
